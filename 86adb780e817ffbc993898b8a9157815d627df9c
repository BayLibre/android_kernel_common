      },
      "writtenOn": "2023-04-07T20:02:39Z",
      "side": 1,
      "message": "It needs to return the pointer so it can be stored in the trusty_state struct of the caller",
      "parentUuid": "d5f155bb_c41619e0",
      "revId": "86adb780e817ffbc993898b8a9157815d627df9c",
