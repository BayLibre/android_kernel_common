      "lineNbr": 132,
      "author": {
        "id": 1964575
      },
      "writtenOn": "2023-04-11T21:08:03Z",
      "side": 1,
      "message": "Crash has been fixed by initializing hdr_size and percpu_data_size in alloc function. It is doubly fixed using sizeof() instead of these members when calculating the offset (see Arve\u0027s comment regarding these members being writable by another OS).",
      "parentUuid": "d52c2e0f_6036be0b",
      "revId": "86adb780e817ffbc993898b8a9157815d627df9c",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
