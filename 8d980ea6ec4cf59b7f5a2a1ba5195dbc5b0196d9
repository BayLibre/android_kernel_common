      "author": {
        "id": 4222956
      },
      "writtenOn": "2025-11-06T06:34:06Z",
      "side": 1,
      "message": "the latest spec (released Sep. this year) is here:\n\nhttps://www.intel.com/content/www/us/en/developer/tools/trust-domain-extensions/documentation.html\n\nit says the value is fixed:\n\n      \"EBX\": [\n        {\n          \"MSB\": \"11\",\n          \"LSB\": \"0\",\n          \"Field Size\": \"12\",\n          \"Field Name\": \"L\",\n          \"Configuration Details\": null,\n          \"Bit or Field Virtualization Type\": \"Fixed\",\n          \"Virtualization Details\": \"0x3F\"\n        },",
      "parentUuid": "1f76c329_7a31705d",
      "revId": "8d980ea6ec4cf59b7f5a2a1ba5195dbc5b0196d9",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
