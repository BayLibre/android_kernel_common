      "lineNbr": 232,
      "author": {
        "id": 1020578
      },
      "writtenOn": "2022-10-21T21:05:51Z",
      "side": 1,
      "message": "Yeah, surprisingly doesn\u0027t add a lot of overhead, so didn\u0027t try to optimize it.",
      "parentUuid": "fbee6cd0_1b7a49e0",
      "range": {
        "startLine": 232,
        "startChar": 1,
        "endLine": 232,
        "endChar": 5
      },
      "revId": "9f76aee1b9dffbad9ae1193ff05b1d64090c307a",
