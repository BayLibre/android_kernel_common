    },
    {
      "unresolved": false,
      "key": {
        "uuid": "bf667339_832a3475",
        "filename": "drivers/android/process.rs",
        "patchSetId": 8
      },
      "lineNbr": 662,
      "author": {
        "id": 1892347
      },
      "writtenOn": "2024-01-11T09:44:28Z",
      "side": 1,
      "message": "Not only are they local to the driver; they are local to the `Process` struct. Other structs can have methods of the same name without a conflict.\n\nI\u0027ve renamed this method.",
      "parentUuid": "48bd66a6_00d41a80",
      "revId": "8cb9ad5d5cf5cd989d82dff8e0112dbeb0976532",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
