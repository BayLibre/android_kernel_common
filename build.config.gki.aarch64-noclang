. ${ROOT_DIR}/common/build.config.gki.aarch64

POST_DEFCONFIG_CMDS="${POST_DEFCONFIG_CMDS} && disable_lto"

ABI_DEFINITION=android/abi_gki_aarch64_noclang.xml
KMI_SYMBOL_LIST=android/abi_gki_aarch64_noclang

function disable_lto() {
  ${KERNEL_DIR}/scripts/config --file ${OUT_DIR}/.config \
    -e LTO_NONE \
    -d LTO_CLANG \
    -d SHADOW_CALL_STACK
  (cd ${OUT_DIR} && \
   make O=${OUT_DIR} CLANG_TRIPLE=${CLANG_TRIPLE} CROSS_COMPILE=${CROSS_COMPILE} "${TOOL_ARGS[@]}" ${MAKE_ARGS} olddefconfig)
}
