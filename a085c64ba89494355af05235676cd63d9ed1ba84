      "side": 1,
      "message": "/* mmc_gpio_cd_irqt hook handle\n * 1.counter the irq count, we will use it in our factory test.\n * 2.update card status.\n * 3.Clear the bad card state MMC_BAD_CARD.\n * 4.check the inserted status of card, return directly if status is not right.\n * 5.schedule mmc_rescan, and set the delay according to MMC_FAST_POWER_OFF.\n */\nstatic void vmmc_gpio_cd_irqt(void *data, struct mmc_host *host, bool *allow)\n{\n\tint status;\n\n\t*allow \u003d false;\n\t/*\n\t * In case host-\u003eops are not yet initialized return immediately.\n\t * The card will get detected later when host driver calls\n\t * mmc_add_host() after host-\u003eops are initialized.\n\t */\n\tif (host-\u003eslot.android_oem_data1)\n\t\tint_cnt++;\n\tif (!host-\u003eops) {\n\t\tpr_err(\"%s: %d: %s host-\u003eops null\\n\",\n\t\t       __func__, __LINE__, mmc_hostname(host));\n\t\treturn;\n\t}\n\tif (host-\u003eops-\u003ecard_event) {\n\t\thost-\u003eops-\u003ecard_event(host);\n\t\thost-\u003eandroid_oem_data1 \u0026\u003d ~MMC_BAD_CARD;\n\t\tpr_info(\"%s: %d: %s clear bad card flag\\n\",\n\t\t\t__func__, __LINE__, mmc_hostname(host));\n\t}\n\n\tstatus \u003d mmc_gpio_get_cd(host);\n\tif (status \u003c 0) {\n\t\tpr_err(\"%s: %d: %s mmc_gpio_get_cd err: %d\\n\",\n\t\t       __func__, __LINE__, mmc_hostname(host), status);\n\t\treturn;\n\t}\n\n\tif(!(host-\u003ecaps2 \u0026 MMC_CAP2_CD_ACTIVE_HIGH)){\n\t\tsd_cmd_done_status \u003d 0;\n\t}\n\tpr_info(\"%s: %d: %s slot status %s, GPIO_ACTIVE_%s\\n\",\n\t\t__func__, __LINE__, mmc_hostname(host), status ? \"HIGH\" : \"LOW\",\n\t\t(host-\u003ecaps2 \u0026 MMC_CAP2_CD_ACTIVE_HIGH) ? \"HIGH\" : \"LOW\");\n\thost-\u003etrigger_card_event \u003d true;\n\tif (!host-\u003ecard)\n\t\tmmc_detect_change(host, msecs_to_jiffies(2050));\n\telse\n\t\tmmc_detect_change(host, msecs_to_jiffies(host-\u003eandroid_oem_data1 \u0026 MMC_FAST_POWER_OFF ? 50 : 1000));\n}",
      "range": {
        "startLine": 37,
        "startChar": 1,
        "endLine": 37,
        "endChar": 34
