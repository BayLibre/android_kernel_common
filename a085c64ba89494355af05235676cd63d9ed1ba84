      "writtenOn": "2023-04-25T10:45:38Z",
      "side": 1,
      "message": "/* mmc_blk_reset hook handle\n * 1.mark MMC_BAD_CARD flag, which will be used in sdhci_get_cd(mmc/host/sdhci.c) and be cleared in mmc_gpio_cd_irqt.(mmc/core/slot-gpio.c).\n * 2.set card status MMC_CARD_REMOVED.\n * 3.schedule mmc_rescan.\n */\nstatic void vmmc_blk_reset(void *data, struct mmc_host *host, int err)\n{\n\tif (err) {\n\t\tpr_err(\"%s: %d: %s failed to reset %d\\n\",\n\t\t       __func__, __LINE__, mmc_hostname(host), err);\n\n\t\tif (host-\u003ecard \u0026\u0026 mmc_card_sd(host-\u003ecard)) {\n\t\t\tpr_err(\"%s: %d: %s removing bad card\\n\",\n\t\t\t       __func__, __LINE__, mmc_hostname(host));\n\t\t\thost-\u003eandroid_oem_data1 |\u003d MMC_BAD_CARD;\n\t\t\tmmc_card_set_removed(host-\u003ecard);\n\t\t\tmmc_detect_change(host, msecs_to_jiffies(1000));\n\t\t}\n\t}\n}",
      "range": {
        "startLine": 1017,
        "startChar": 2,
        "endLine": 1017,
        "endChar": 32
      },
      "revId": "a085c64ba89494355af05235676cd63d9ed1ba84",
