      "message": "/* mmc_attach_sd_err hook handle\n * 1.mark  MMC_BAD_CARD flag, which will be used in sdhci_get_cd(mmc/host/sdhci.c) and be cleared in mmc_gpio_cd_irqt.(mmc/core/slot-gpio.c).\n */\nstatic void vmmc_attach_sd_err(void *data, struct mmc_host *host, u32 ocr, int err)\n{\n\thost-\u003eandroid_oem_data1 |\u003d MMC_BAD_CARD;\n\tpr_info(\"%s: %d: %s set bad card: %d(ocr\u003d0x%08x)\\n\",\n\t\t__func__, __LINE__, mmc_hostname(host), err, ocr);\n}",
