      "writtenOn": "2023-04-25T10:45:38Z",
      "side": 1,
      "message": "/* sd_update_bus_speed_mode hook handle\n * 1.check if SDR104 is supported, if not, try to set sd_bus_speed DDR50 if supported.\n */\nstatic void vsd_update_bus_speed_mode(void *data, struct mmc_card *card)\n{\n\tconst char *const uhs_speeds[] \u003d {\n\t\t[UHS_SDR12_BUS_SPEED] \u003d \"SDR12 \",\n\t\t[UHS_SDR25_BUS_SPEED] \u003d \"SDR25 \",\n\t\t[UHS_SDR50_BUS_SPEED] \u003d \"SDR50 \",\n\t\t[UHS_SDR104_BUS_SPEED] \u003d \"SDR104 \",\n\t\t[UHS_DDR50_BUS_SPEED] \u003d \"DDR50 \",\n\t};\n\tbool support_sdr104 \u003d\n\t\tcard-\u003ehost-\u003eandroid_oem_data1 \u0026 MMC_SUPPORT_SDR104;\n\n\tif ((!support_sdr104) \u0026\u0026 (card-\u003esd_bus_speed \u003d\u003d UHS_SDR104_BUS_SPEED)) {\n\t\tif ((card-\u003ehost-\u003ecaps \u0026 MMC_CAP_UHS_DDR50) \u0026\u0026\n\t\t    (card-\u003esw_caps.sd3_bus_mode \u0026 SD_MODE_UHS_DDR50)) {\n\t\t\tcard-\u003esd_bus_speed \u003d UHS_DDR50_BUS_SPEED;\n\t\t}\n\t}\n\tpr_info(\"%s: %d: %s %s SDR104, final mode %s\\n\",\n\t\t__func__, __LINE__, mmc_hostname(card-\u003ehost),\n\t\tsupport_sdr104 ? \"support\" : \"not support\", uhs_speeds[card-\u003esd_bus_speed]);\n}",
      "range": {
        "startLine": 487,
        "startChar": 1,
        "endLine": 487,
        "endChar": 42
      },
      "revId": "a085c64ba89494355af05235676cd63d9ed1ba84",
