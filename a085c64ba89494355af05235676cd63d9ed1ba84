      "message": "/* sdhci_get_cd hook handle\n * 1. if MMC_BAD_CARD, return directly in sdhci_get_cd.\n */\nstatic void vsdhci_get_cd(void *data, struct sdhci_host *host, bool *allow)\n{\n\t*allow \u003d true;\n\n\tif (host-\u003emmc-\u003eandroid_oem_data1 \u0026 MMC_BAD_CARD) {\n\t\t*allow \u003d false;\n\t\tpr_info(\"%s: %d: %s bad card allow\u003d%d\\n\",\n\t\t\t__func__, __LINE__, mmc_hostname(host-\u003emmc), *allow);\n\t}\n}",
