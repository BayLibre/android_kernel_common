      },
      "lineNbr": 421,
      "author": {
        "id": 1000205
      },
      "writtenOn": "2024-01-17T02:26:09Z",
      "side": 1,
      "message": "Can you add this to a comment. If the current rbtree api requires two extra allocations and another tree search when looking up a NodeRef from a node pointer, then I think a TODO comment to optimize this then the rbtree api is improved would be a useful reminder.",
      "parentUuid": "d4185d5c_8c29fe7b",
      "revId": "c0bf3401d8ad68c748aa0c67ef2ed634bafbfd7e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
