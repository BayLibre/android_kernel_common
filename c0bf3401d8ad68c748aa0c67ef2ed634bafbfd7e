      "author": {
        "id": 1892347
      },
      "writtenOn": "2024-01-09T09:45:34Z",
      "side": 1,
      "message": "The driver used to allocate memory while holding this mutex. Not sure if that\u0027s still the case.",
      "parentUuid": "7d0bd4ee_54a32b11",
      "range": {
        "startLine": 242,
        "startChar": 15,
        "endLine": 242,
        "endChar": 20
      },
      "revId": "c0bf3401d8ad68c748aa0c67ef2ed634bafbfd7e",
