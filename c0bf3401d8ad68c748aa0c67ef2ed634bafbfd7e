      "writtenOn": "2024-01-17T02:26:09Z",
      "side": 1,
      "message": "\u003e * A mutex on process. Used only to protect the collection of nodes.\n\nDo you mean the collection of NodeRefs or is there another mutex on the process?",
      "parentUuid": "2119c221_4af3a5c0",
      "revId": "c0bf3401d8ad68c748aa0c67ef2ed634bafbfd7e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
