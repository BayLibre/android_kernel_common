      "side": 1,
      "message": "Consider using `dev_pm_opp_free_cpufreq_table()` here so that the allocation and deallocation of the data structure is symmetric.",
      "revId": "ba35458c874bc0349c36b805a10200648e4b6738",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
