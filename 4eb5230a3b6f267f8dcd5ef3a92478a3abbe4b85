        "id": 1137063
      },
      "writtenOn": "2021-06-01T19:55:48Z",
      "side": 1,
      "message": "Shouldn\u0027t the integrity check be the first thing that module_init does, not the last thing?",
      "range": {
        "startLine": 508,
        "startChar": 6,
        "endLine": 508,
        "endChar": 31
      },
      "revId": "4eb5230a3b6f267f8dcd5ef3a92478a3abbe4b85",
