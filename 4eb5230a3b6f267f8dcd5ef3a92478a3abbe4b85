      "writtenOn": "2021-06-01T19:55:48Z",
      "side": 1,
      "message": "A comment here would help.  Something like: \"The FIPS module\u0027s algorithms are expected to be built from the same source code as the in-kernel ones so that they are fully compatible.  In general there\u0027s no way to verify full compatibility at runtime, but we can at least verify that the algorithm properties match.\"",
      "range": {
        "startLine": 347,
        "startChar": 0,
        "endLine": 348,
        "endChar": 53
      },
      "revId": "4eb5230a3b6f267f8dcd5ef3a92478a3abbe4b85",
