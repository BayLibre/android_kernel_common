        "id": 1137063
      },
      "writtenOn": "2021-06-01T19:55:48Z",
      "side": 1,
      "message": "Is it okay for the self-tests to run after the fips implementations are already potentially in-use?  I.e. is this going to be handled by documenting that the module is not \"in FIPS mode\" until it has been successfully loaded, or similar?",
      "range": {
        "startLine": 506,
        "startChar": 1,
        "endLine": 506,
        "endChar": 29
      },
      "revId": "4eb5230a3b6f267f8dcd5ef3a92478a3abbe4b85",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
