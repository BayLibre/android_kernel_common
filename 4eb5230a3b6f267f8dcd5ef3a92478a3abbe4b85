    },
    {
      "unresolved": true,
      "key": {
        "uuid": "16d0b6a2_77e1dd34",
        "filename": "crypto/fips140-integrity.c",
        "patchSetId": 22
      },
      "lineNbr": 508,
      "author": {
        "id": 1843125
      },
      "writtenOn": "2021-06-03T16:17:17Z",
      "side": 1,
      "message": "If we allocate a hmac(sha256) shash TFM any earlier, it will be provided by builtin code, and the whole point of this little dance (however pointless) is that the code checks its own integrity. Therefore, I don\u0027t see how we could do this any differently.",
      "parentUuid": "341a02a4_92093e6f",
      "range": {
        "startLine": 508,
        "startChar": 6,
        "endLine": 508,
        "endChar": 31
      },
      "revId": "4eb5230a3b6f267f8dcd5ef3a92478a3abbe4b85",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
