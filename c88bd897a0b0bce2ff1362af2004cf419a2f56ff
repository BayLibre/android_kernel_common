      "writtenOn": "2020-06-28T10:44:18Z",
      "side": 1,
      "message": "We separated job for USB audio offloading between ABOX and exynos_usb_audio at the beginning of the design.\n\n\nsound/soc/samsung/abox/abox.c\n\n1067 int abox_iommu_map(struct device *dev, unsigned long iova,\n1068                 phys_addr_t addr, size_t bytes, void *area)\n1069 {\n1070         struct abox_data *data \u003d dev_get_drvdata(dev);\n1071         struct abox_iommu_mapping *mapping;\n1072         unsigned long flags;\n1073         int ret;\n1074\n1075         dev_dbg(dev, \"%s(%#lx, %#zx)\\n\", __func__, iova, bytes);\n1076\n1077         if (!area) {\n1078                 dev_warn(dev, \"%s(%#lx): no virtual address\\n\", __func__, iova);\n1079                 area \u003d phys_to_virt(addr);\n1080         }\n1081\n1082         mapping \u003d devm_kmalloc(dev, sizeof(*mapping), GFP_KERNEL);\n1083         if (!mapping) {\n1084                 ret \u003d -ENOMEM;\n1085                 goto out;\n1086         }\n1087\n1088         ret \u003d iommu_map(data-\u003eiommu_domain, iova, addr, bytes, 0);\n1089         if (ret \u003c 0) {\n1090                 devm_kfree(dev, mapping);\n1091                 dev_err(dev, \"iommu_map(%#lx) fail: %d\\n\", iova, ret);\n1092                 goto out;\n1093         }\n1094\n1095         mapping-\u003eiova \u003d iova;\n1096         mapping-\u003eaddr \u003d addr;\n1097         mapping-\u003earea \u003d area;\n1098         mapping-\u003ebytes \u003d bytes;\n1099\n1100         spin_lock_irqsave(\u0026data-\u003eiommu_lock, flags);\n1101         list_add(\u0026mapping-\u003elist, \u0026data-\u003eiommu_maps);\n1102         spin_unlock_irqrestore(\u0026data-\u003eiommu_lock, flags);\n1103 out:\n1104         return ret;\n1105 }\n1106 EXPORT_SYMBOL(abox_iommu_map);",
