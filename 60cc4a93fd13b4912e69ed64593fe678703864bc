      },
      "writtenOn": "2023-07-06T23:45:49Z",
      "side": 1,
      "message": "You\u0027re checking this flag in several places, so maybe add a static helper function?",
      "revId": "60cc4a93fd13b4912e69ed64593fe678703864bc",
