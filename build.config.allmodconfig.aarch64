. ${ROOT_DIR}/common/build.config.common
. ${ROOT_DIR}/common/build.config.aarch64
. ${ROOT_DIR}/common/build.config.allmodconfig

# CPU_BIG_ENDIAN is currently broken on this branch with clang-9
if [ -z "$POST_DEFCONFIG_CMDS" ]; then
    POST_DEFCONFIG_CMDS=aarch64_update_allmodconfig
else
    POST_DEFCONFIG_CMDS="$POST_DEFCONFIG_CMDS && aarch64_update_allmodconfig"
fi

function aarch64_update_allmodconfig() {
    ${KERNEL_DIR}/scripts/config --file ${OUT_DIR}/.config \
         -d CPU_BIG_ENDIAN
    (cd ${OUT_DIR} && \
     make O=${OUT_DIR} $archsubarch CC=${CC} CROSS_COMPILE=${CROSS_COMPILE} olddefconfig)
}
