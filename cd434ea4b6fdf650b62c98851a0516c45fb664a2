      "writtenOn": "2020-10-15T20:03:29Z",
      "side": 1,
      "message": "Hi Greg KH, \nsched_set_fifo is void function and we don\u0027t know whether switch really happened or not. \n\nsched_setscheduler_nocheck returns the success or error, so that we do appropriate steps at the end of cpu hotplug in.",
      "parentUuid": "71ccd99f_7161c5f0",
      "range": {
        "startLine": 1197,
        "startChar": 0,
        "endLine": 1197,
        "endChar": 65
      },
      "revId": "cd434ea4b6fdf650b62c98851a0516c45fb664a2",
