    },
    {
      "unresolved": true,
      "key": {
        "uuid": "748e7f26_e5ad61e4",
        "filename": "kernel/cpu.c",
        "patchSetId": 4
      },
      "lineNbr": 1197,
      "author": {
        "id": 1125653
      },
      "writtenOn": "2020-10-16T10:07:38Z",
      "side": 1,
      "message": "If you can not switch, you have bigger issues happening, right?  You still want to keep going, and not error out, to allow the process to continue.\n\nHave you ever seen this fail?",
      "parentUuid": "ed16ece7_f0eb8d34",
      "range": {
        "startLine": 1197,
        "startChar": 0,
        "endLine": 1197,
        "endChar": 65
      },
      "revId": "cd434ea4b6fdf650b62c98851a0516c45fb664a2",
