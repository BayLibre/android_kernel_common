      "writtenOn": "2025-10-29T04:51:17Z",
      "side": 1,
      "message": "yeah, that makes sense. will change it.",
      "parentUuid": "1813169c_f091c408",
      "revId": "d61fe9755076eea43145357b6cf2e8bd378e2a73",
