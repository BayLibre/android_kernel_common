      "writtenOn": "2026-01-21T17:29:58Z",
      "side": 1,
      "message": "I would suggest doing this unconditionally from __hyp_pool_init() and unconditionally check the tag from __find_buddy_avail() to protect all hyp pool instances. Maybe in a separate patch?",
      "range": {
        "startLine": 308,
        "startChar": 0,
        "endLine": 323,
        "endChar": 1
      },
      "revId": "856d6551c01b47dd5e521c60cb9fef63475b49be",
