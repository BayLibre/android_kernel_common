      "side": 0,
      "message": "What do you gain by making this a read_lock()? It feels like any concurrency you enable here, is just going to backfire when then sequence count gets updated later.",
      "range": {
        "startLine": 1759,
        "startChar": 1,
        "endLine": 1759,
        "endChar": 11
      },
      "revId": "745079a042887713eb8ea215927582425e6134f8",
