      "writtenOn": "2024-10-09T03:59:59Z",
      "side": 1,
      "message": "We have extensively customized the CFS (Completely Fair Scheduler) scheduler and introduced a workqueue with higher priority than the default kblockd workqueue. In our testing environment, we have observed instances where the kblockd workqueue experiences scheduler latencies ranging from dozens to hundreds of milliseconds. Our primary goal is to utilize this customized workqueue to reduce scheduler latency.",
      "parentUuid": "34aab2f8_3a0894f0",
      "range": {
        "startLine": 2266,
        "startChar": 0,
        "endLine": 2269,
        "endChar": 9
      },
      "revId": "c2160e6ab424c1ac31c6a61c1d55bcb8df57b661",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
