        "id": 1879222
      },
      "writtenOn": "2024-10-09T03:59:59Z",
      "side": 1,
      "message": "The frequent gating and ungating of the clock by the UFS controller makes it impossible to prevent requeueing. Our goal is to minimize scheduler latency when requeueing occurs.",
      "parentUuid": "9a91a2c5_6386fd0e",
      "range": {
        "startLine": 1508,
        "startChar": 0,
        "endLine": 1512,
        "endChar": 9
