      },
      "writtenOn": "2022-12-15T18:51:12Z",
      "side": 1,
      "message": "Alright, abandoned that change and pushed out a patch for option number 2. Thank you for the help and prompt replies by the way. We appreciate it",
      "parentUuid": "8b4198f7_d7fe49f4",
      "revId": "04019cb610c69086e74568fed3112147360d1824",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
