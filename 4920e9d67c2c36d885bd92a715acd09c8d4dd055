      },
      "writtenOn": "2025-12-09T16:30:04Z",
      "side": 1,
      "message": "And then perhaps also something like this might be useful?\n\n```\n--- a/drivers/iommu/intel/dmar.c\n+++ b/drivers/iommu/intel/dmar.c\n@@ -1512,10 +1512,12 @@ int qi_submit_sync(struct intel_iommu *iommu, struct qi_desc *desc,\n            dmar_latency_enabled(iommu, DMAR_LATENCY_INV_IEC))\n                iec_start_ktime \u003d ktime_to_ns(ktime_get());\n \n-       if (pkvm_pviommu_enabled())\n+       if (pkvm_pviommu_enabled()) {\n+               WARN_ON_ONCE(type !\u003d QI_IEC_TYPE || count !\u003d 1);\n                rc \u003d pkvm_hc_qi_submit_sync(iommu-\u003ereg_phys, virt_to_phys(desc), count);\n-       else\n+       } else {\n                rc \u003d __qi_submit_sync(iommu, desc, count, options);\n+       }\n \n        if (iotlb_start_ktime)\n                dmar_latency_update(iommu, DMAR_LATENCY_INV_IOTLB,\n```",
      "parentUuid": "1e66ff22_24b1db50",
      "revId": "4920e9d67c2c36d885bd92a715acd09c8d4dd055",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "c785b173_e4596cbf",
        "filename": "arch/x86/kvm/vmx/pkvm/hyp/iommu.c",
