                "endLine": 931,
                "endChar": 0
              },
              "replacement": "\t/*\n\t * vPMU is not supported by pKVM yet. Don\u0027t trick the pVM that it is.\n\t * Ensure MSR_IA32_MISC_ENABLE has PEBS and BTS unavailable bits set.\n\t */\n\tkvm_x86_call(set_msr)(vcpu, MSR_IA32_MISC_ENABLE,\n\t\t\t       MSR_IA32_MISC_ENABLE_PEBS_UNAVAIL |\n\t\t\t       MSR_IA32_MISC_ENABLE_BTS_UNAVAIL, false);\n\n"
            },
