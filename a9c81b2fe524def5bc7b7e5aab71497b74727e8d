      "writtenOn": "2024-03-05T09:58:23Z",
      "side": 1,
      "message": "I realised exactly this a little later. I am now fighting with Kleaf over CONFIG_RUST in defconfig.",
      "parentUuid": "0b1ad9d1_809cd892",
      "range": {
        "startLine": 123,
        "startChar": 11,
        "endLine": 123,
