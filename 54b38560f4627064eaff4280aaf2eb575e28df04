      },
      "writtenOn": "2022-02-09T15:28:15Z",
      "side": 1,
      "message": "Check that fraglen is no bigger than the rx buffer, to avoid a bug in TF-A resulting in buffer overflow.",
      "revId": "54b38560f4627064eaff4280aaf2eb575e28df04",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
