    {
      "key": {
        "uuid": "ccd45ad6_c7eb5642",
        "filename": "drivers/net/wireless/virt_wifi.c",
        "patchSetId": 4
      },
      "lineNbr": 409,
      "author": {
        "id": 1291337
      },
      "writtenOn": "2019-10-03T20:54:55Z",
      "side": 1,
      "message": "The notify_device_open and notify_device_stop calls are mismatched here. The notify_device_open callback is invoked when the net_device is created, but the notify_device_stop callback is invoked when the wiphy is destroyed.\n\nThere is only one wiphy for the virt_wifi module which is created and destroyed together with the module as it is loaded and unloaded. On the other hand, net_devices can be created and destroyed as long as the module is loaded through using the \"ip link add ... type virt_wifi ... \" commands in the guest.\n\nvirt_wifi_net_device_stop would be a closer match.",
      "range": {
        "startLine": 408,
        "startChar": 1,
        "endLine": 409,
        "endChar": 31
      },
      "revId": "09d9d20d8f9cff0ba957aa556f20195490f2cb29",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
