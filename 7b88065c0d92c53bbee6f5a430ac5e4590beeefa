              "path": "mm/vmscan.c",
              "range": {
                "startLine": 2396,
                "startChar": 0,
                "endLine": 2397,
                "endChar": 0
              },
              "replacement": "\tif (*nr_scanned !\u003d nr_scanned_before)\n"
            },
            {
              "path": "mm/vmscan.c",
              "range": {
                "startLine": 2777,
                "startChar": 0,
                "endLine": 2779,
                "endChar": 0
              },
              "replacement": "\tunsigned long nr_taken \u003d 0;\n\tunsigned long nr_scanned \u003d 0;\n"
            }
          ]
        }
      ],
