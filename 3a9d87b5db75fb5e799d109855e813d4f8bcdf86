      "writtenOn": "2023-03-10T13:13:43Z",
      "side": 1,
      "message": "Seems like we could but as this is soon after the rootfs_initcall, it won\u0027t give much time to the initramfs to be extracted.\n\nWhat was the original reason for the device_initcall_sync?",
      "parentUuid": "7510fa38_d66fa700",
      "range": {
        "startLine": 475,
        "startChar": 0,
        "endLine": 475,
        "endChar": 13
      },
      "revId": "3a9d87b5db75fb5e799d109855e813d4f8bcdf86",
