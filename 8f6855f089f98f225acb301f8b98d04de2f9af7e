        "id": 1137063
      },
      "writtenOn": "2021-06-09T23:08:16Z",
      "side": 1,
      "message": "This acquires a reference which is never dropped.",
      "range": {
        "startLine": 336,
        "startChar": 12,
        "endLine": 336,
        "endChar": 33
      },
      "revId": "8f6855f089f98f225acb301f8b98d04de2f9af7e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
