        "uuid": "5868b1db_6be6bf35",
        "filename": "crypto/fips140-module.c",
        "patchSetId": 26
      },
      "lineNbr": 322,
      "author": {
        "id": 1137063
      },
      "writtenOn": "2021-06-09T23:08:16Z",
      "side": 1,
      "message": "How is this protected against concurrent calls to crypto_unregister_alg()?",
      "range": {
        "startLine": 322,
        "startChar": 37,
        "endLine": 322,
        "endChar": 60
      },
      "revId": "8f6855f089f98f225acb301f8b98d04de2f9af7e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "a0deded1_e164f8c3",
        "filename": "crypto/fips140-module.c",
        "patchSetId": 26
      },
      "lineNbr": 322,
      "author": {
        "id": 1843125
      },
      "writtenOn": "2021-06-10T14:05:43Z",
      "side": 1,
      "message": "I am updating this to take the algo off the list first, with crypto_alg_sem held. That should ensure that crypto_unregister_alg() and this code are not both freeing the algo.",
      "parentUuid": "5868b1db_6be6bf35",
      "range": {
        "startLine": 322,
        "startChar": 37,
        "endLine": 322,
        "endChar": 60
      },
      "revId": "8f6855f089f98f225acb301f8b98d04de2f9af7e",
