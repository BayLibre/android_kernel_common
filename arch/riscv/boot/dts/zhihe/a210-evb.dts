/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "a210.dtsi"
#include "a210-android-unused.dtsi"

/ {
	model = "A210 EVB configuration";
	compatible = "zhihe,a210-evb", "zhihe,a210";

	aliases {
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;

		mmc0 = &emmc;
		serial4 = &uart4;
	};

	/* The actual capacity will be adjusted through SPL */
	memory@0 {
		device_type = "memory";
		reg = <0x00 0x80000000  0x01 0x00000000>; /* 4G */
		numa-node-id = <0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x40000000>;
			alloc-ranges = <0x00 0x90000000 0x00 0x40000000>;
			linux,cma-default;
		};

		memory@1c000000 {
			reg = <0x00 0x1c000000 0x00 0x2000000>;
			no-map;
		};

		memblock-memory@17b800000 {
			reg = <0x01 0x7b800000 0x00 0x04000000>;
			no-map;
		};
	};

	/* The bootargs in U-Boot will override the configuration set here. */
	chosen {
		stdout-path = "serial4";
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};
};

&peri2_padctrl {
	uart4_pins: uart4-0 {
		tx-pins {
			pins = "GPIO2_0";
			function = "uart4";
			bias-disable;
			drive-strength = <3>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		rx-pins {
			pins = "GPIO2_1";
			function = "uart4";
			bias-disable;
			drive-strength = <1>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	hdmi_pins: hdmi-0 {
		hdmi-pins {
			pins = "GPIO2_25", "GPIO2_30", "GPIO2_31";
			function = "hdmi";
			bias-disable;
			drive-strength = <3>;
			input-enable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins>;
};

&rtc {
	status = "okay";
};

&dpu {
	status = "okay";
};

&hdmi_tx {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_pins>;
	status = "okay";
};

&hdmi_out_port {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&usb3 {
	dr_mode = "peripheral";
};

&aon_padctrl {
	aoi2c1_pins: aoi2c1-0 {
		i2c-pins {
			pins = "AOI2C1_SCL", "AOI2C1_SDA";
			function = "aoi2c1";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};
};

&aoi2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&aoi2c1_pins>;
	clock-frequency = <400000>;
	status = "okay";

	aw9535_1: gpio@21 {
		compatible = "awinic,aw9535", "nxp,pca9535";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"PCIE_BAT_EN", "AUDIO_3V3_PWREN", "AUDIO_1V8_PWREN", "MIPI_CSI0_PWREN",
			"MIPI_CSI1_PWREN", "MIPI_TP_PWREN", "PCIE_3V3_EN", "PCIE_12V_EN",
			"USBCON_PWREN", "USBCON1_PWREN", "PCIE_3V3_AUX_EN", "SDIO_3V3_PWREN",
			"SDIO_1V8_PWREN", "SIT91211_3V3_EN", "MIPI_DSI_PWREN", "BL_EN";
	};
};

&usb20phy0 {
	pwren-gpios = <&aw9535_1 8 GPIO_ACTIVE_HIGH>;
};

&usb20phy1 {
	pwren-gpios = <&aw9535_1 9 GPIO_ACTIVE_HIGH>;
};

&emmc {
	max-frequency = <196608000>;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs200-1_8v;
	no-sdio;
	no-sd;
	bus-width = <8>;
	cap-mmc-highspeed;
};

&cluster0_opp {
	opp0-500000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1200000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1500000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1698000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1896000000 {
		opp-microvolt = <1000000>;
	};
};

&cluster1_opp {
	opp1-500000000 {
		opp-microvolt = <1000000>;
	};
	opp1-1698000000 {
		opp-microvolt = <1000000>;
	};
	opp1-1896000000 {
		opp-microvolt = <1000000>;
	};
	opp1-2298000000 {
		opp-microvolt = <1000000>;
	};
};
