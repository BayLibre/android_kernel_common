/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "a210.dtsi"
#include "a210-android-unused.dtsi"

/ {
	model = "A210 EVB configuration";
	compatible = "zhihe,a210-evb", "zhihe,a210";

	aliases {
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;

		mmc0 = &emmc;
		serial4 = &uart4;
	};

	/* The actual capacity will be adjusted through SPL */
	memory@0 {
		device_type = "memory";
		reg = <0x00 0x80000000  0x01 0x00000000>; /* 4G */
		numa-node-id = <0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x40000000>;
			alloc-ranges = <0x00 0x90000000 0x00 0x40000000>;
			linux,cma-default;
		};

		memory@1c000000 {
			reg = <0x00 0x1c000000 0x00 0x2000000>;
			no-map;
		};

		memblock-memory@17b800000 {
			reg = <0x01 0x7b800000 0x00 0x04000000>;
			no-map;
		};
	};

	/* The bootargs in U-Boot will override the configuration set here. */
	chosen {
		stdout-path = "serial4";
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};
};

&peri2_padctrl {
	uart4_pins: uart4-0 {
		tx-pins {
			pins = "GPIO2_0";
			function = "uart4";
			bias-disable;
			drive-strength = <3>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		rx-pins {
			pins = "GPIO2_1";
			function = "uart4";
			bias-disable;
			drive-strength = <1>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	hdmi_pins: hdmi-0 {
		hdmi-pins {
			pins = "GPIO2_25", "GPIO2_30", "GPIO2_31";
			function = "hdmi";
			bias-disable;
			drive-strength = <3>;
			input-enable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins>;
};

&rtc {
	status = "okay";
};

&dpu {
	status = "okay";
};

&hdmi_tx {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_pins>;
	status = "okay";
};

&hdmi_out_port {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&usb3 {
	dr_mode = "peripheral";
};

&aon_padctrl {
	aoi2c1_pins: aoi2c1-0 {
		i2c-pins {
			pins = "AOI2C1_SCL", "AOI2C1_SDA";
			function = "aoi2c1";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};
};

&aoi2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&aoi2c1_pins>;
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * HP_CTL_H (P13, index 11) enables the headset jack output.
	 * "nxp,pca9535" fallback: gpio-pca953x has no awinic,aw9535 match.
	 * The INT line is left unused (nothing consumes expander interrupts).
	 */
	aw9535_0: gpio@20 {
		compatible = "awinic,aw9535", "nxp,pca9535";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"CSI1_PWDN_IO0", "CSI1_RST_IO1", "CSI1_FSIN_IO2", "CSI0_PWDN_IO3",
			"CSI0_RST_IO4", "CSI0_FSIN_IO5", "PCIE_X1_PRSNT_L_IO6", "PCIE_X4_PRSNT_L_IO7",
			"AUDIO1_PARST0_IO8", "AUDIO_ADC1_INT_IO9", "AUDIO_ADC0_INT_IO10", "HP_CTL_H_IO11",
			"SIT91211_SSC_EN_IO12", "DISP_RST_IO13", "SWITCH3_SEL_IO14", "SWITCH1_SEL_IO15";
	};

	aw9535_1: gpio@21 {
		compatible = "awinic,aw9535", "nxp,pca9535";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"PCIE_BAT_EN", "AUDIO_3V3_PWREN", "AUDIO_1V8_PWREN", "MIPI_CSI0_PWREN",
			"MIPI_CSI1_PWREN", "MIPI_TP_PWREN", "PCIE_3V3_EN", "PCIE_12V_EN",
			"USBCON_PWREN", "USBCON1_PWREN", "PCIE_3V3_AUX_EN", "SDIO_3V3_PWREN",
			"SDIO_1V8_PWREN", "SIT91211_3V3_EN", "MIPI_DSI_PWREN", "BL_EN";
	};
};

&usb20phy0 {
	pwren-gpios = <&aw9535_1 8 GPIO_ACTIVE_HIGH>;
};

&usb20phy1 {
	pwren-gpios = <&aw9535_1 9 GPIO_ACTIVE_HIGH>;
};

&clk_gpu {
	status = "okay";
};

&power_gpu {
	status = "okay";
};

&emmc {
	max-frequency = <196608000>;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs200-1_8v;
	no-sdio;
	no-sd;
	bus-width = <8>;
	cap-mmc-highspeed;
};

&cluster0_opp {
	opp0-500000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1200000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1500000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1698000000 {
		opp-microvolt = <1000000>;
	};
	opp0-1896000000 {
		opp-microvolt = <1000000>;
	};
};

&cluster1_opp {
	opp1-500000000 {
		opp-microvolt = <1000000>;
	};
	opp1-1698000000 {
		opp-microvolt = <1000000>;
	};
	opp1-1896000000 {
		opp-microvolt = <1000000>;
	};
	opp1-2298000000 {
		opp-microvolt = <1000000>;
	};
};

/*
 * WiFi/BT: Realtek RTL8822CS on an O-Net (Fn-Link) 6222B-SRC module.
 * WiFi is on the SDIO host (sdhci0), BT is on UART5 speaking H5.
 */
/ {
	wifi_3v3: regulator-wifi-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "wifi_vdd_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&aw9535_1 11 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};

	wifi_1v8: regulator-wifi-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "wifi_vdd_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&aw9535_1 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
};

&peri1_padctrl {
	sdhci_pins: sdhci0-1 {
		sd-pins {
			pins = "GPIO1_1";
			function = "sdio";
			bias-disable;
			drive-strength = <13>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};
};

&peri2_padctrl {
	uart5_pins: uart5-0 {
		uart-pins {
			pins = "GPIO2_18", "GPIO2_19";	/* TXD, RXD */
			function = "uart5";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	uart5_rts_cts_pins: uart5-1 {
		uart-pins {
			pins = "GPIO3_10", "GPIO3_9";	/* RTSN, CTSN */
			function = "uart5";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};
};

&sdhci0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sdhci_pins>;
	bus-width = <4>;
	non-removable;
	no-sd;
	no-mmc;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	max-frequency = <196608000>;

	mmc-ddr-1_8v;
	post-power-on-delay-ms = <200>;
	vmmc-supply = <&wifi_3v3>;
	vqmmc-supply = <&wifi_1v8>;
	mmc-pwrseq = <&wifi_pwrseq>;

	#address-cells = <1>;
	#size-cells = <0>;

	rtl8822cs: wifi@1 {
		reg = <1>;
		interrupt-parent = <&ao_gpio1>;
		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
	};
};

&uart5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pins>, <&uart5_rts_cts_pins>;
	uart-has-rtscts;

	bluetooth {
		compatible = "realtek,rtl8822cs-bt";
		enable-gpios = <&ao_gpio1 4 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&ao_gpio0 30 GPIO_ACTIVE_HIGH>;
		device-wake-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * Audio (A210 SODIMM V2 baseboard): I2S1 <-> ES8156 (DAC, I2C5 0x08) /
 * ES7210 (ADC, I2C5 0x40), on the 3.5mm headset jack.
 * ES8156 LOUT/ROUT drive the headphones (output enabled by HP_CTL_H on
 * aw9535_0 P13), the headset mic goes to the ES7210. Jack insertion is
 * reported by HP_DET_L on GPIO0_16. There is no speaker amplifier on V2.
 * Both codecs are I2S clock consumers - I2S1 provides BCLK/LRCK (stated
 * with bitclock-master/frame-master on its endpoint).
 * audio-graph-card2 "Semi-Multi" link (CPU:Codec = 1:2): both codecs
 * share the single I2S1 DAI link, so the card exposes one PCM device
 * (device 0) with playback (ES8156, playback-only) and capture (ES7210,
 * capture-only).
 *
 * HDMI audio: I2S3 SD0 feeds the dw-hdmi I2S audio input internally (no
 * pins), as a second card link -> PCM device 1. The HDMI DAI of the I2S
 * driver is DAI 1, so the link sits on port@1 of the I2S node.
 */
/ {
	sound {
		compatible = "audio-graph-card2";
		label = "A210-EVB-Audio";
		links = <&i2s1_port>, <&i2s3_hdmi_port>;
		/* "Headphones" is the DAPM pin driven by hp-det-gpios */
		widgets = "Headphone", "Headphones";
		routing = "Headphones", "ES8156 LOUT",
			  "Headphones", "ES8156 ROUT";
		hp-det-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

		multi {
			#address-cells = <1>;
			#size-cells = <0>;

			ports@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* (X) to pair with the CPU */
				port@0 {
					reg = <0>;
					mcodec_ep: endpoint {
						remote-endpoint = <&i2s1_ep>;
					};
				};

				/* (A) Multi element: playback DAC */
				port@1 {
					reg = <1>;
					mcodec_dac_ep: endpoint {
						remote-endpoint = <&es8156_ep>;
					};
				};

				/* (B) Multi element: capture ADC */
				port@2 {
					reg = <2>;
					mcodec_adc_ep: endpoint {
						remote-endpoint = <&es7210_ep>;
					};
				};
			};
		};
	};
};

&peri2_padctrl {
	i2c5_pins: i2c5-1 {
		i2c-pins {
			pins = "GPIO2_28", "GPIO2_29";	/* SCL, SDA */
			function = "i2c5";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	i2s1_pins: i2s1-0 {
		i2s-pins {
			pins = "GPIO2_2", "GPIO2_3", "GPIO2_4", "GPIO2_5", "GPIO2_6";
			function = "i2s1";
			bias-disable;
			drive-strength = <13>;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	clock-frequency = <400000>;
	status = "okay";

	codec_es8156: audio-codec@8 {
		compatible = "everest,es8156";
		reg = <0x8>;
		#sound-dai-cells = <1>;
		sound-name-prefix = "ES8156";
		mclk-sclk-ratio = <4>;
		audio-3v3-pwren-gpios = <&aw9535_1 1 GPIO_ACTIVE_HIGH>;
		audio-1v8-pwren-gpios = <&aw9535_1 2 GPIO_ACTIVE_HIGH>;
		audio-hp-ctl-gpios = <&aw9535_0 11 GPIO_ACTIVE_HIGH>;

		port {
			es8156_ep: endpoint {
				remote-endpoint = <&mcodec_dac_ep>;
			};
		};
	};

	codec_es7210: audio-codec@40 {
		compatible = "everest,es7210";
		reg = <0x40>;
		#sound-dai-cells = <1>;
		work-mode = "ES7210_NORMAL_I2S";
		channels-max = <2>;
		mclk-sclk-ratio = <4>;
		sound-name-prefix = "ES7210";

		port {
			es7210_ep: endpoint {
				remote-endpoint = <&mcodec_adc_ep>;
			};
		};
	};
};

&audio_i2s1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1_pins>;
	status = "okay";

	/*
	 * DAI 0 (pcm-i2s1-dai). I2S1 is the BCLK/LRCK provider: with
	 * audio-graph-card2 the provider must be stated on the CPU endpoint,
	 * otherwise the CPU DAI is set up as clock consumer (BC_FC) and,
	 * the codecs being consumers too, nobody drives BCLK/LRCK - the I2S
	 * never requests DMA data.
	 */
	i2s1_port: port {
		i2s1_ep: endpoint {
			remote-endpoint = <&mcodec_ep>;
			dai-format = "i2s";
			bitclock-master;
			frame-master;
		};
	};
};

&audio_i2s_8ch_sd0 {
	multi-channels = <2>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		i2s3_hdmi_port: port@1 {
			reg = <1>;
			i2s3_hdmi_ep: endpoint {
				remote-endpoint = <&hdmi_audio_ep>;
				dai-format = "i2s";
				playback-only;
				bitclock-master;
				frame-master;
			};
		};
	};
};

&hdmi_tx {
	ports {
		port@2 {
			reg = <2>;
			hdmi_audio_ep: endpoint {
				remote-endpoint = <&i2s3_hdmi_ep>;
			};
		};
	};
};
