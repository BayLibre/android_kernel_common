		gmac0: ethernet@0002100000{
			compatible = "zhihe,a210-dwmac", "snps,dwmac-5.40a";
			reg = <0x00 0x02100000 0x0 0x10000>;
			reg-names = "gmac";
			interrupt-parent = <&intc>;
			interrupts = <277>;
			interrupt-names = "macirq";
			clocks = <&clk_peri PERI1_GMAC0_ACLK_EN>,
					 <&clk_peri PERI1_GMAC0_HCLK_EN>;
			clock-names = "gmac_aclk", "gmac_hclk";
			power-domains = <&power_top>;
			snps,pbl = <32>;
			snps,fixed-burst;
			snps,axi-config = <&stmmac_axi_setup>;
