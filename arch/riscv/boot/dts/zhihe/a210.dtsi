				#power-domain-cells = <0>;
				id = <A210_PD_VP_WRAP>;
				resets = <&rst VP_G2D_PRST>, <&rst VP_G2D_CRST>,
					 <&rst VP_G2D_ARST>, <&rst VP_COMP_PRST>,
					 <&rst VP_COMP_CRST>, <&rst VP_COMP_ARST>,
					 <&rst VP_DECOMP_PRST>, <&rst VP_DECOMP_CRST>,
