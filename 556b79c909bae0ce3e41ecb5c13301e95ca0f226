      "writtenOn": "2026-03-04T02:11:40Z",
      "side": 1,
      "message": "Would it be simpler to use number-of-pages instead of bytes?",
      "range": {
        "startLine": 17,
        "startChar": 0,
        "endLine": 19,
        "endChar": 22
      },
      "revId": "556b79c909bae0ce3e41ecb5c13301e95ca0f226",
