        "patchSetId": 1
      },
      "lineNbr": 16,
      "author": {
        "id": 1894539
      },
      "writtenOn": "2026-03-05T15:04:54Z",
      "side": 1,
      "message": "Rename request_bytes to size.\nRename end_addr to next_addr, which indicates the next address to be called.\nRefine comments",
      "parentUuid": "cd3f2e3b_e6ee2018",
      "range": {
        "startLine": 16,
        "startChar": 4,
        "endLine": 16,
        "endChar": 49
