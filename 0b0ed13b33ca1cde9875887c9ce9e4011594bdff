      "writtenOn": "2022-08-25T23:52:53Z",
      "side": 1,
      "message": "hmm, perhaps I\u0027m missing something but why do we have to call `xfrm_state_ok()` if we are going to skip any errors? Couldn\u0027t we just start at `idx \u003d sp-\u003everified_cnt`?",
      "range": {
        "startLine": 3271,
        "startChar": 3,
        "endLine": 3271,
        "endChar": 5
      },
      "revId": "0b0ed13b33ca1cde9875887c9ce9e4011594bdff",
