    },
    {
      "unresolved": true,
      "key": {
        "uuid": "8b27047e_2230075e",
        "filename": "net/xfrm/xfrm_policy.c",
        "patchSetId": 4
      },
      "lineNbr": 3271,
      "author": {
        "id": 1221725
      },
      "writtenOn": "2022-08-26T00:24:30Z",
      "side": 1,
      "message": "No; there\u0027s a two-way match going on here - All templates MUST find a matching secpath entry, and all tunnel-mode secpath entries MUST be verified against a template.\n\nSo if we start idx at sp-\u003everified_cnt, and the policy_check method was called multiple times we\u0027d end up with templates that don\u0027t match secpath entries, and that would be a bug, since there clearly is one that should be matching in the secpath. The only other approach would be to start at `sp-\u003everified_cnt - tmpl_cnt`, but there\u0027s potential for optional transport-mode transforms that may break that, so it\u0027s much more prone to off-by-one bugs.\n\nSo the more reliable and idempotent approach is to treat these as \"optional\" and continue searching.",
      "parentUuid": "81ab1d42_b27f4dc9",
      "range": {
        "startLine": 3271,
        "startChar": 3,
        "endLine": 3271,
        "endChar": 5
      },
