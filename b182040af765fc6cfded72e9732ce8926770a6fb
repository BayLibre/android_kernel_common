        "endLine": 6943,
        "endChar": 58
      },
      "revId": "b182040af765fc6cfded72e9732ce8926770a6fb",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "65ea1bbb_bdddd4ee",
        "filename": "security/selinux/hooks.c",
        "patchSetId": 1
      },
      "lineNbr": 6943,
      "author": {
        "id": 1124848
      },
      "writtenOn": "2019-08-15T13:06:57Z",
      "side": 1,
      "message": "I think what we have now is fine. For example, it would make not much sense to pass \u0027PERF_SECURITY_EVENT_OPEN\u0027 through attr. It has to be passed in as a parameter to LSM to request the \u0027type of check\u0027",
      "parentUuid": "f5e7d5d4_6066525b",
      "range": {
        "startLine": 6943,
        "startChar": 64,
        "endLine": 6943,
        "endChar": 68
      },
      "revId": "b182040af765fc6cfded72e9732ce8926770a6fb",
