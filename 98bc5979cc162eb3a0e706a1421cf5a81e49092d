      "writtenOn": "2022-10-10T16:10:33Z",
      "side": 1,
      "message": "For the signing:\n\n\u003e Module-signing is not supported for GKI vendor modules. [...]\nhttps://source.android.com/docs/core/architecture/kernel/loadable-kernel-modules#module-signing",
      "parentUuid": "f5c52625_f52667dd",
      "revId": "98bc5979cc162eb3a0e706a1421cf5a81e49092d",
