      "writtenOn": "2022-10-11T03:16:27Z",
      "side": 1,
      "message": "Yes, you need to have the `CONFIG_MODULE_SIG_ALL` disabled in your vendor config fragment.\n\nPlease refer GKI Announcement on 2022-jan-21 for details at:  https://docs.partner.android.com/partners/guides/gki/whatsnew#2022-jan-21",
      "parentUuid": "0f18578b_d5d02182",
      "revId": "98bc5979cc162eb3a0e706a1421cf5a81e49092d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
