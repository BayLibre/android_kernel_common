      },
      "writtenOn": "2024-10-23T16:27:51Z",
      "side": 1,
      "message": "\u003e Do you mean wrapper driver in their downstream kernels or changes in their downstream kernels are dependent on dwc-\u003eusbX_generic_phy and hence its usage needs to kept same ?\n\nYes, that is the case.",
      "parentUuid": "a753f6b3_5117b17d",
      "revId": "df8979c9403a97750c577ba00f50535817583c6e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
