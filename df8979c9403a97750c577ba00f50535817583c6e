      },
      "writtenOn": "2024-10-24T02:29:24Z",
      "side": 1,
      "message": "Shouldn\u0027t downstream depend on and adapt to AOSP and not the other way round ?",
      "parentUuid": "f4165c9d_e3df8dc2",
      "revId": "df8979c9403a97750c577ba00f50535817583c6e",
