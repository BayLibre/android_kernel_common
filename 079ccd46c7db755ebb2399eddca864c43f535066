        "id": 1869395
      },
      "writtenOn": "2024-07-12T22:15:06Z",
      "side": 1,
      "message": "do we need to fixup `do_full_int80()` upstream instead? e.g. a workaround to not use the bp register?",
      "parentUuid": "9f3e2234_c9f30e07",
      "range": {
        "startLine": 1960,
        "startChar": 33,
        "endLine": 1960,
        "endChar": 54
      },
      "revId": "079ccd46c7db755ebb2399eddca864c43f535066",
