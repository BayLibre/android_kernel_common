      "message": "Cherry pick is not clean. Checked against Android commit.\nAndroid commit: [source](https://android.googlesource.com/kernel/common/+/0d61a651e4dd3c61d1658cc92e0b0450c8374738).\n\n```\n    - ## Documentation/admin-guide/kernel-parameters.txt ##\n    -@@\n    - \t\t\tfirmware feature for updating multiple TCE entries\n    - \t\t\tat a time.\n    - \n    -+\tkswapd_per_node\u003d\n    -+\t\t\tkswapd_per_node allows you to control the number of kswapd threads\n    -+\t\t\trunning on the system. This provides the ability to devote additional\n    -+\t\t\tCPU resources toward proactive page replacement with the goal of\n    -+\t\t\treducing direct reclaims. When direct reclaims are prevented, the CPU\n    -+\t\t\tconsumed by them is prevented as well. Depending on the workload, the\n    -+\t\t\tresult can cause aggregate CPU usage on the system to go up, down or\n    -+\t\t\tstay the same.\n    -+\n    -+\t\t\tMore aggressive page replacement can reduce direct reclaims which\n    -+\t\t\tcause latency for tasks and decrease throughput when doing filesystem\n    -+\t\t\tIO through the pagecache. Direct reclaims are recorded using the\n    -+\t\t\tallocstall counter in /proc/vmstat.\n    -+\n    -+\t\t\tThe range of acceptible values are 1-16. Always start with lower\n    -+\t\t\tvalues in the 2-6 range. Higher values should be justified with\n    -+\t\t\ttesting. If direct reclaims occur in spite of high values, the cost\n    -+\t\t\tof direct reclaims (in latency) that occur can be higher due to\n    -+\t\t\tincreased lock contention.\n    -+\n    - \tonenand.bdry\u003d\t[HW,MTD] Flex-OneNAND Boundary Configuration\n    - \n    - \t\t\tFormat: [die0_boundary][,die0_lock][,die1_boundary][,die1_lock]\n    +    Change-Id: I8425cab7f40cbeaf65af0ea118c1a9ac7da0930e\n    +    [quic_vjitta@quicinc.com]: Resolved minor merge conflicts\n    +    Signed-off-by: Vijayanand Jitta \u003cquic_vjitta@quicinc.com\u003e\n    +    [quic_c_spathi@quicinc.com]: Resolved minor merge conflicts\n    +    Signed-off-by: Srinivasarao Pathipati \u003cquic_c_spathi@quicinc.com\u003e\n    +\n    + ## drivers/android/vendor_hooks.c ##\n    +@@ drivers/android/vendor_hooks.c: EXPORT_TRACEPOINT_SYMBOL_GPL(android_vh_alloc_uid);\n    + EXPORT_TRACEPOINT_SYMBOL_GPL(android_vh_free_user);\n    + EXPORT_TRACEPOINT_SYMBOL_GPL(android_vh_save_vmalloc_stack);\n    + EXPORT_TRACEPOINT_SYMBOL_GPL(android_vh_show_stack_hash);\n    ++EXPORT_TRACEPOINT_SYMBOL_GPL(android_vh_kswapd_per_node);\n     \n      ## include/linux/mmzone.h ##\n     @@\n    @@ include/linux/mmzone.h\n      \tMIGRATE_UNMOVABLE,\n      \tMIGRATE_MOVABLE,\n     @@ include/linux/mmzone.h: typedef struct pglist_data {\n    - \twait_queue_head_t pfmemalloc_wait;\n    - \tstruct task_struct *kswapd;\t/* Protected by\n    - \t\t\t\t\t   mem_hotplug_begin/end() */\n    + \tstruct mutex kswapd_lock;\n    + #endif\n    + \tstruct task_struct *kswapd;\t/* Protected by kswapd_lock */\n     +\tstruct task_struct *mkswapd[MAX_KSWAPD_THREADS];\n      \tint kswapd_order;\n      \tenum zone_type kswapd_highest_zoneidx;\n      \n     \n    + ## include/trace/hooks/vmscan.h ##\n    +@@ include/trace/hooks/vmscan.h: enum scan_balance;\n    + DECLARE_HOOK(android_vh_tune_scan_type,\n    + \tTP_PROTO(enum scan_balance *scan_type),\n    + \tTP_ARGS(scan_type));\n    ++DECLARE_HOOK(android_vh_kswapd_per_node,\n    ++\tTP_PROTO(int nid, bool *skip, bool run),\n    ++\tTP_ARGS(nid, skip, run));\n    + #endif /* _TRACE_HOOK_VMSCAN_H */\n    + /* This part must be outside protection */\n    + #include \u003ctrace/define_trace.h\u003e\n    +\n      ## mm/vmscan.c ##\n    -@@ mm/vmscan.c: struct scan_control {\n    -  */\n    - int vm_swappiness \u003d 60;\n    - \n    -+#define DEF_KSWAPD_THREADS_PER_NODE 1\n    -+int kswapd_threads \u003d DEF_KSWAPD_THREADS_PER_NODE;\n    -+static int __init kswapd_per_node_setup(char *str)\n    -+{\n    -+\tint tmp;\n    -+\n    -+\tif (kstrtoint(str, 0, \u0026tmp) \u003c 0)\n    -+\t\treturn 0;\n    -+\n    -+\tif (tmp \u003e MAX_KSWAPD_THREADS || tmp \u003c\u003d 0)\n    -+\t\treturn 0;\n    -+\n    -+\tkswapd_threads \u003d tmp;\n    -+\treturn 1;\n    -+}\n    -+__setup(\"kswapd_per_node\u003d\", kswapd_per_node_setup);\n    -+\n    - static void set_task_reclaim_state(struct task_struct *task,\n    - \t\t\t\t   struct reclaim_state *rs)\n    +@@ mm/vmscan.c: unsigned long shrink_all_memory(unsigned long nr_to_reclaim)\n    + void __meminit kswapd_run(int nid)\n      {\n    -@@ mm/vmscan.c: kswapd_try_sleep:\n    - \treturn 0;\n    - }\n    + \tpg_data_t *pgdat \u003d NODE_DATA(nid);\n    ++\tbool skip \u003d false;\n      \n    -+static int kswapd_per_node_run(int nid)\n    -+{\n    -+\tpg_data_t *pgdat \u003d NODE_DATA(nid);\n    -+\tint hid;\n    -+\tint ret \u003d 0;\n    -+\n    -+\tfor (hid \u003d 0; hid \u003c kswapd_threads; ++hid) {\n    -+\t\tpgdat-\u003emkswapd[hid] \u003d kthread_run(kswapd, pgdat, \"kswapd%d:%d\",\n    -+\t\t\t\t\t\t\t\tnid, hid);\n    -+\t\tif (IS_ERR(pgdat-\u003emkswapd[hid])) {\n    -+\t\t\t/* failure at boot is fatal */\n    -+\t\t\tWARN_ON(system_state \u003c SYSTEM_RUNNING);\n    -+\t\t\tpr_err(\"Failed to start kswapd%d on node %d\\n\",\n    -+\t\t\t\thid, nid);\n    -+\t\t\tret \u003d PTR_ERR(pgdat-\u003emkswapd[hid]);\n    -+\t\t\tpgdat-\u003emkswapd[hid] \u003d NULL;\n    -+\t\t\tcontinue;\n    + \tpgdat_kswapd_lock(pgdat);\n    + \tif (!pgdat-\u003ekswapd) {\n    ++\t\ttrace_android_vh_kswapd_per_node(nid, \u0026skip, true);\n    ++\t\tif (skip) {\n    ++\t\t\tpgdat_kswapd_unlock(pgdat);\n    ++\t\t\treturn;\n     +\t\t}\n    -+\t\tif (!pgdat-\u003ekswapd)\n    -+\t\t\tpgdat-\u003ekswapd \u003d pgdat-\u003emkswapd[hid];\n    -+\t}\n     +\n    -+\treturn ret;\n    -+}\n    -+\n    -+static void kswapd_per_node_stop(int nid)\n    -+{\n    -+\tint hid \u003d 0;\n    -+\tstruct task_struct *kswapd;\n    -+\n    -+\tfor (hid \u003d 0; hid \u003c kswapd_threads; hid++) {\n    -+\t\tkswapd \u003d NODE_DATA(nid)-\u003emkswapd[hid];\n    -+\t\tif (kswapd) {\n    -+\t\t\tkthread_stop(kswapd);\n    -+\t\t\tNODE_DATA(nid)-\u003emkswapd[hid] \u003d NULL;\n    -+\t\t}\n    -+\t}\n    -+\tNODE_DATA(nid)-\u003ekswapd \u003d NULL;\n    -+}\n    -+\n    - /*\n    -  * A zone is low on free memory or too fragmented for high-order memory.  If\n    -  * kswapd should reclaim (direct reclaim is deferred), wake it up for the zone\u0027s\n    -@@ mm/vmscan.c: int kswapd_run(int nid)\n    - \tif (pgdat-\u003ekswapd)\n    - \t\treturn 0;\n    - \n    -+\tif (kswapd_threads \u003e 1)\n    -+\t\treturn kswapd_per_node_run(nid);\n    -+\n    - \tpgdat-\u003ekswapd \u003d kthread_run(kswapd, pgdat, \"kswapd%d\", nid);\n    - \tif (IS_ERR(pgdat-\u003ekswapd)) {\n    - \t\t/* failure at boot is fatal */\n    -@@ mm/vmscan.c: void kswapd_stop(int nid)\n    + \t\tpgdat-\u003ekswapd \u003d kthread_run(kswapd, pgdat, \"kswapd%d\", nid);\n    + \t\tif (IS_ERR(pgdat-\u003ekswapd)) {\n    + \t\t\t/* failure at boot is fatal */\n    +@@ mm/vmscan.c: void __meminit kswapd_stop(int nid)\n      {\n    - \tstruct task_struct *kswapd \u003d NODE_DATA(nid)-\u003ekswapd;\n    + \tpg_data_t *pgdat \u003d NODE_DATA(nid);\n    + \tstruct task_struct *kswapd;\n    ++\tbool skip \u003d false;\n      \n    -+\tif (kswapd_threads \u003e 1) {\n    -+\t\tkswapd_per_node_stop(nid);\n    + \tpgdat_kswapd_lock(pgdat);\n    + \tkswapd \u003d pgdat-\u003ekswapd;\n    ++\n    ++\ttrace_android_vh_kswapd_per_node(nid, \u0026skip, false);\n    ++\tif (skip) {\n    ++\t\tpgdat_kswapd_unlock(pgdat);\n     +\t\treturn;\n     +\t}\n    -+\n      \tif (kswapd) {\n      \t\tkthread_stop(kswapd);\n    - \t\tNODE_DATA(nid)-\u003ekswapd \u003d NULL;\n    + \t\tpgdat-\u003ekswapd \u003d NULL;\n```\n\n\nPlease refer to the contribution guidelines for details:\nhttps://android.googlesource.com/kernel/common/+/refs/heads/android-mainline/README.md",
