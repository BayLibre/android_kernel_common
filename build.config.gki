DEFCONFIG=gki_defconfig
#POST_DEFCONFIG_CMDS="check_defconfig"
POST_DEFCONFIG_CMDS="check_defconfig && update_debug_config"

function update_debug_config() {
    ${KERNEL_DIR}/scripts/config --file ${OUT_DIR}/.config \
	-e CONFIG_DEBUG_KERNEL \
	-e CONFIG_DEBUG_TIMEKEEPING \
	-e CONFIG_CGROUP_DEBUG \
	-e CONFIG_PARAVIRT_DEBUG \
	-e CONFIG_DEBUG_LOCK_ALLOC \
	-e CONFIG_DEBUG_LOCKDEP \
	-e CONFIG_DEBUG_ATOMIC_SLEEP \
	-e CONFIG_DEBUG_LOCKING_API_SELFTESTS \
	--set-val CONFIG_TORTURE_TEST m \
	--set-val CONFIG_LOCK_TORTURE_TEST m \
	--set-val CONFIG_SCF_TORTURE_TEST m \
	--set-val CONFIG_RCU_TORTURE_TEST m \
	-e CONFIG_PROVE_RCU \
	--set-val CONFIG_CMA n \
	-e CONFIG_DEBUG_OBJECTS_RCU_HEAD \
	-e CONFIG_PROVE_LOCKING \
	-e CONFIG_LOCK_STAT

    (cd ${OUT_DIR} && \
     make ${TOOL_ARGS} O=${OUT_DIR} olddefconfig)
}

function update_kasan_config() {
    ${KERNEL_DIR}/scripts/config --file ${OUT_DIR}/.config \
         -e CONFIG_KASAN \
         --set-val CONFIG_FRAME_WARN 0 \
         -d CFI \
         -d CFI_PERMISSIVE \
         -d CFI_CLANG \
         -d SHADOW_CALL_STACK
    (cd ${OUT_DIR} && \
     make ${TOOL_ARGS} O=${OUT_DIR} olddefconfig)
}
