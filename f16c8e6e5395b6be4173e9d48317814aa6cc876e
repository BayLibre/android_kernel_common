      "writtenOn": "2023-08-03T10:58:46Z",
      "side": 1,
      "message": "Joel thought it was necessary in earlier version, but not sure if it still needed now, right. Joel, do you think it\u0027s still needed with the rcu_barrier() now in place around the write?",
      "parentUuid": "baedf67b_22e9364f",
      "range": {
        "startLine": 3120,
        "startChar": 69,
        "endLine": 3120,
        "endChar": 78
      },
      "revId": "f16c8e6e5395b6be4173e9d48317814aa6cc876e",
