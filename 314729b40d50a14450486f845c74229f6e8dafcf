    {
      "key": {
        "uuid": "e3d883b1_2526f2da",
        "filename": "kernel/sched/fair.c",
        "patchSetId": 4
      },
      "lineNbr": 6756,
      "author": {
        "id": 1122323
      },
      "writtenOn": "2017-12-19T19:33:31Z",
      "side": 1,
      "message": "We disable want_affine because we\u0027re going to do an energy_aware placement, where we will use the highest sched domain which is not overutilized. The biggest thing that brings us is the ability to continue to use energy-awareness in non-overutilized groups, for example if we have a big task overutilizing a big CPU, we would have a non-overutilized little group where we will try to place a small task, and per-sd overutilized flags allow us to recognise this.\n\nIn regard to Joel\u0027s patch, this should be fine - the slow path (MAINLINE_PREFER_IDLE) placement code can never return true from wake_energy if it\u0027s needed, so wake_affine setting should be unchanged.\n\nI will keep this the same.",
      "parentUuid": "35683351_2de7979d",
      "range": {
        "startLine": 6756,
        "startChar": 16,
        "endLine": 6756,
        "endChar": 28
      },
      "revId": "314729b40d50a14450486f845c74229f6e8dafcf",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
