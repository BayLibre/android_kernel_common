        "id": 1930620
      },
      "writtenOn": "2022-11-17T21:19:08Z",
      "side": 1,
      "message": "I guess in that sense EOPNOTSUPP makes sense for the partial functions but not the original ones.",
      "parentUuid": "7c1015d4_bb00f000",
      "revId": "cd9c3f40e52edec7f24e585c48a89db7f72b9501",
