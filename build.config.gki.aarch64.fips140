. ${ROOT_DIR}/${KERNEL_DIR}/build.config.gki.aarch64

FILES="
crypto/fips140.ko
"
MAKE_GOALS="
crypto/fips140.ko
"

if [ "${LTO}" = "none" ]; then
	echo "The FIPS140 module needs LTO to be enabled."
	exit 1
fi

MODULES_ORDER=android/gki_aarch64_fips140_modules
KERNEL_DIR=common

DEFCONFIG=fips140_gki_defconfig
PRE_DEFCONFIG_CMDS="mkdir -p \${OUT_DIR}/arch/arm64/configs/ && cat ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/gki_defconfig ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/fips140_gki.fragment > \${OUT_DIR}/arch/arm64/configs/${DEFCONFIG};"
POST_DEFCONFIG_CMDS=""
