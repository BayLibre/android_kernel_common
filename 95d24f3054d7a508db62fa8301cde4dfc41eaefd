        "id": 1591476
      },
      "writtenOn": "2020-04-16T10:23:10Z",
      "side": 1,
      "message": "It shows mb() is to do with compiler ordering.. not for the Hardware execution order. Is that right ?\nIMO, this has to do with compiler ordering only as explained below at #409.",
      "parentUuid": "c409e0c8_319466df",
      "range": {
        "startLine": 336,
        "startChar": 0,
        "endLine": 336,
        "endChar": 6
      },
      "revId": "95d24f3054d7a508db62fa8301cde4dfc41eaefd",
