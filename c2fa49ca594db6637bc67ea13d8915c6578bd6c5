      },
      "writtenOn": "2025-01-22T14:22:47Z",
      "side": 1,
      "message": "And doesn\u0027t `HCIDEVRESET` cover this already?",
      "parentUuid": "c3765603_84d4e3c1",
      "revId": "c2fa49ca594db6637bc67ea13d8915c6578bd6c5",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
