      },
      "writtenOn": "2019-05-21T17:28:32Z",
      "side": 1,
      "message": "if np-\u003edev is atomic, there is no need to add spinlocks ...",
      "range": {
        "startLine": 206,
        "startChar": 0,
        "endLine": 208,
        "endChar": 27
      },
      "revId": "e43ba023452692e322cf38f022b467757f12997c",
