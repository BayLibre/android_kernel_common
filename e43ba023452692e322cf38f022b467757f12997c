      "writtenOn": "2019-05-22T10:26:52Z",
      "side": 1,
      "message": "no need for a lock here, get_device() on NULL will be fine, and you can\u0027t change a pointer in an unatomic way on Linux.",
      "range": {
        "startLine": 61,
        "startChar": 0,
        "endLine": 61,
        "endChar": 27
      },
      "revId": "e43ba023452692e322cf38f022b467757f12997c",
