      "writtenOn": "2024-01-08T18:17:43Z",
      "side": 1,
      "message": "No, we could do that.",
      "parentUuid": "ad45db86_3ca4ec27",
      "revId": "0dfd18dc7d1428993739d87d1ab015e8424b4393",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
