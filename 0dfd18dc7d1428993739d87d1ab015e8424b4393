      "author": {
        "id": 1892347
      },
      "writtenOn": "2024-01-08T10:16:15Z",
      "side": 1,
      "message": "It always pops the top of the stack; that\u0027s the first line of this function. The search operation is for determining what the transaction stack should be after replying, in case this thread is part of the transaction stack several times.",
      "parentUuid": "2870629d_156b9a46",
      "revId": "0dfd18dc7d1428993739d87d1ab015e8424b4393",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
