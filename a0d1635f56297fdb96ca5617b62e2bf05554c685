      "writtenOn": "2019-08-27T19:20:45Z",
      "side": 1,
      "message": "Which CMA heaps will correspond to this standard range defined here? Using one of these implies that system image can rely on it and so must be made available by all vendors??\n\nSimilar comment/question(s) for carveout heaps.",
      "range": {
        "startLine": 49,
