      "writtenOn": "2018-05-08T00:30:12Z",
      "side": 1,
      "message": "Is it safe to take this lock while holding x1-\u003elock?",
      "range": {
        "startLine": 1398,
        "startChar": 2,
        "endLine": 1398,
        "endChar": 14
      },
      "revId": "941e82e9f85ba13b2d13312fa7766a704e4f6a1c",
